{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VinaySobarad/c2-edge-lab/policy/schema.json",
  "title": "c2-edge-lab redirector policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "header", "paths", "user_agents", "backend", "decoy"],
  "properties": {
    "version": { "const": 1 },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$" },
        "value": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes"],
      "properties": {
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "user_agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_exact": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "allow_regex": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scanner_substrings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "decoy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "index"],
      "properties": {
        "root": { "type": "string", "pattern": "^/" },
        "index": { "type": "string", "pattern": "^[^/]+$" }
      }
    }
  }
}
