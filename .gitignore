.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
generated/*.conf
.coverage

# HashiCorp Terraform.gitignore — local state, tfvars, overrides, CLI config.
# https://github.com/github/gitignore/blob/main/Terraform.gitignore
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
*.tfplan

# Partial S3 backend file (bucket name). Example stays: *.tfbackend.example
terraform/*.tfbackend
terraform/backend.hcl
