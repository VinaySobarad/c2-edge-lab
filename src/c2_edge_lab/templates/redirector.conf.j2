map_hash_bucket_size 256;

map ${{ header_nginx_var }} $c2e_header_ok {
    default {% if header_open %}1{% else %}0{% endif %};
{% if header_value %}    "{{ header_value }}" 1;
{% endif %}}

map $http_user_agent $c2e_ua_class {
    default other;
{% if scanner_pattern %}    ~*({{ scanner_pattern }}) scanner;
{% endif %}{% for ua in allow_exact %}    "{{ ua }}" allow;
{% endfor %}{% for pattern in allow_regex %}    ~*{{ pattern }} allow;
{% endfor %}}

map "$c2e_header_ok:$c2e_ua_class" $c2e_gate {
    default decoy;
    "1:allow" proxy;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    root {{ decoy_root }};

{% for prefix in path_prefixes %}    location {{ prefix }} {
        error_page 418 = @proxy;
        error_page 419 = @decoy;
        if ($c2e_gate = proxy) { return 418; }
        return 419;
    }

{% endfor %}    location / {
        try_files /{{ decoy_index }} =200;
    }

    location @proxy {
        proxy_pass http://{{ backend_host }}:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location @decoy {
        try_files /{{ decoy_index }} =200;
    }
}
