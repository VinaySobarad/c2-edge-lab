#!/bin/bash
set -euo pipefail

install -d -m 0750 '${pull_root}'
install -d -m 0755 '${agent_lib_dir}'

printf '%s' '${s3_pull_b64}' | base64 -d > '${agent_lib_dir}/s3_pull.py'
chmod 0755 '${agent_lib_dir}/s3_pull.py'

cat > '${agent_lib_dir}/echo.py' << 'PY'
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LISTEN_PORT = ${listen_port}
BODY = b"${echo_body}"


class EchoHandler(BaseHTTPRequestHandler):
    def log_message(self, format: str, *args: object) -> None:
        return

    def _ok(self) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(BODY)))
        self.end_headers()
        self.wfile.write(BODY)

    def do_GET(self) -> None:
        self._ok()

    def do_HEAD(self) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(BODY)))
        self.end_headers()

    def do_POST(self) -> None:
        self._ok()


def main() -> None:
    server = ThreadingHTTPServer(("0.0.0.0", LISTEN_PORT), EchoHandler)
    server.serve_forever()


if __name__ == "__main__":
    main()
PY

cat > /etc/systemd/system/c2-edge-echo.service << EOF
[Unit]
Description=c2-edge-lab teamserver echo stub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 ${agent_lib_dir}/echo.py
Restart=always
RestartSec=2
User=nobody
Group=nogroup

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now c2-edge-echo.service
